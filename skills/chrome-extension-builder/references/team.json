  "scheduling": {
    "conditional_nodes": "Mark not-applicable with a reason; dependents then proceed. Missing evidence never counts as pass.",
    "parallelism": "Only after contracts are frozen and file ownership is disjoint. Backend/integrations/frontend may run concurrently; security/performance may review independently after integration evidence.",
    "shared_files": "One owner at a time. Orchestrator owns session state; architecture owns shared interface definitions until explicitly handed off.",
    "tool_fallback": "The coordinator loads the mapped lifecycle skill and role prompt relative to this registry. Claude may invoke plugin-scoped native agents when available. Other hosts use available permitted delegation, or execute roles serially without claiming independent reviewers ran.",
    "authorization": "Use the user's existing scope and provider permissions. Prepare concrete artifacts before asking about consequential missing authorization. No blanket extra approval gate."
  },
  "evolution": {
    "max_candidates_per_round": 3,
    "max_rounds": 3,
    "independent_evaluator": "independent-evaluator",
    "hard_blockers": [
      "covert or undisclosed collection",
      "secret exposure",
      "executable remote code",
      "broken authorization",
      "unsafe page-message trust boundary",
      "missing required runtime evidence",
      "invalid release package"
    ],
    "weights": {
      "task_success": 25,
      "security_privacy": 20,
      "usability_accessibility": 20,
      "architecture_reliability": 15,
      "test_evidence": 10,
      "performance_cost": 10
    },
    "dimension_scale": [
      0,
      5
    ],
    "early_exit": [
      "acceptance criteria pass",
      "no material improvement",
      "same blocker repeats",
      "budget exhausted"
    ],
    "selection": "Retain strongest verified candidate; unresolved blockers remain visible."
  }
}
